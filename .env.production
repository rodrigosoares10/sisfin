# Production Environment Variables
# Copie este arquivo e configure com seus valores de produção

# Node Environment
NODE_ENV=production
PORT=3000

# Database (Easypanel irá fornecer)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# CORS (Configure com seu domínio)
CORS_ORIGIN="https://seu-dominio.com"

# Ou permita múltiplas origens separadas por vírgula
# CORS_ORIGIN="https://app.seudominio.com,https://www.seudominio.com"

# Ou use * para permitir todas as origens (não recomendado para produção)
# CORS_ORIGIN="*"
