// Prisma Schema - Sistema Financeiro
// Gerado para gerenciamento financeiro com suporte a transações, produtos, clientes e metas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum TipoProduto {
  UNICO // Pagamento único
  MRR   // Monthly Recurring Revenue
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum MetodoPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  OUTRO
}

enum FrequenciaRecorrencia {
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum TipoCliente {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

enum RoleUsuario {
  ADMIN
  USUARIO
  VISUALIZADOR
}

enum TipoMeta {
  RECEITA
  DESPESA
  LUCRO
}

enum Tema {
  LIGHT
  DARK
}

enum CanalMarketing {
  ORGANICO
  GOOGLE_ADS
  META_ADS
  LINKEDIN_ADS
  EMAIL
  INDICACAO
  PARCERIA
  OUTRO
}

enum TipoCusto {
  COGS      // Cost of Goods Sold
  OPEX      // Operational Expense
  CAC       // Customer Acquisition Cost
}

enum HealthScore {
  EXCELENTE  // 80-100
  BOM        // 60-79
  MEDIO      // 40-59
  RISCO      // 20-39
  CRITICO    // 0-19
}

enum TipoMRRMovement {
  NOVO         // Novo cliente
  EXPANSION    // Upgrade/expansion
  CONTRACTION  // Downgrade
  CHURN        // Cancelamento
  REATIVACAO   // Reativação de churned
}

enum StatusProjeto {
  PLANEJAMENTO
  EM_ANDAMENTO
  REVISAO
  CONCLUIDO
  CANCELADO
}

enum PrioridadeTicket {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusTicket {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
  FECHADO
}

// ========================================
// MODELOS
// ========================================

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      RoleUsuario @default(USUARIO)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([ativo])
  @@map("usuarios")
}

model CentroCusto {
  id         String   @id @default(cuid())
  nome       String
  descricao  String?
  cor        String   @default("#3B82F6") // Cor hexadecimal para UI
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relações
  transacoes       Transacao[]
  metas            Meta[]
  operationalCosts OperationalCost[]

  @@index([ativo])
  @@index([nome])
  @@map("centros_custo")
}

model Cliente {
  id        String      @id @default(cuid())
  nome      String
  email     String?
  telefone  String?
  empresa   String?
  tipo      TipoCliente @default(PESSOA_FISICA)
  ativo     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relações
  transacoes      Transacao[]
  health          CustomerHealth?
  mrrMovements    MRRMovement[]
  agencyProjects  AgencyProject[]
  supportTickets  SupportTicket[]

  @@index([email])
  @@index([tipo])
  @@index([ativo])
  @@index([nome])
  @@map("clientes")
}

model Produto {
  id         String       @id @default(cuid())
  nome       String
  tipo       TipoProduto
  valor      Decimal      @db.Decimal(10, 2)
  descricao  String?
  ativo      Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relações
  transacoes   Transacao[]
  mrrMovements MRRMovement[]

  @@index([ativo])
  @@index([tipo])
  @@index([nome])
  @@map("produtos")
}

model Transacao {
  id               String              @id @default(cuid())
  tipo             TipoTransacao
  valor            Decimal             @db.Decimal(10, 2)
  descricao        String
  data             DateTime            @default(now())
  categoria        String?             // Categoria livre/customizável

  // Recorrência
  recorrente       Boolean             @default(false)
  frequencia       FrequenciaRecorrencia?

  // Pagamento
  statusPagamento  StatusPagamento     @default(PENDENTE)
  metodoPagamento  MetodoPagamento

  // Anexo/Comprovante
  anexoUrl         String?

  // Relacionamentos
  centroCustoId    String
  centroCusto      CentroCusto         @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)

  clienteId        String?
  cliente          Cliente?            @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  produtoId        String?
  produto          Produto?            @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Índices para otimização de queries
  @@index([data])
  @@index([tipo])
  @@index([statusPagamento])
  @@index([centroCustoId])
  @@index([clienteId])
  @@index([produtoId])
  @@index([recorrente])
  @@index([data, tipo]) // Índice composto para filtros comuns
  @@index([centroCustoId, data]) // Índice composto para relatórios por centro de custo
  @@map("transacoes")
}

model Meta {
  id            String     @id @default(cuid())
  tipo          TipoMeta
  valorMeta     Decimal    @db.Decimal(10, 2)
  mes           Int        // 1-12
  ano           Int        // Ex: 2024
  descricao     String?

  // Relacionamento opcional - meta pode ser geral ou específica de um centro de custo
  centroCustoId String?
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Índices para otimização
  @@index([mes, ano])
  @@index([tipo])
  @@index([centroCustoId])
  @@index([ano, mes, tipo]) // Índice composto para queries de período
  @@unique([tipo, centroCustoId, mes, ano]) // Previne metas duplicadas
  @@map("metas")
}

model Configuracao {
  id            String   @id @default(cuid())
  nomeAgencia   String   @default("Minha Agência")
  logoUrl       String?  // URL do logotipo da agência
  tema          Tema     @default(LIGHT)
  corPrimaria   String   @default("#3B82F6") // Cor principal do tema
  corSecundaria String   @default("#10B981") // Cor secundária

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("configuracoes")
}

// ========================================
// MÉTRICAS E ANALYTICS
// ========================================

// Custos de Marketing (CAC)
model MarketingCost {
  id          String          @id @default(cuid())
  canal       CanalMarketing
  campanha    String
  valor       Decimal         @db.Decimal(10, 2)
  data        DateTime        @default(now())
  descricao   String?

  // Métricas adicionais
  leads       Int?            // Leads gerados
  conversoes  Int?            // Conversões (clientes)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([canal])
  @@index([data])
  @@index([data, canal])
  @@map("marketing_costs")
}

// Custos Operacionais (COGS, OPEX)
model OperationalCost {
  id            String     @id @default(cuid())
  tipo          TipoCusto
  categoria     String     // Ex: Cloud, Salários, Licenças, APIs
  descricao     String
  valor         Decimal    @db.Decimal(10, 2)
  data          DateTime   @default(now())

  // Relacionamento opcional com centro de custo
  centroCustoId String?
  centroCusto   CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)

  // Métricas adicionais
  usuariosAtivos Int?       // Para calcular custo por usuário
  transacoes     Int?       // Para calcular custo por transação

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([tipo])
  @@index([data])
  @@index([centroCustoId])
  @@index([data, tipo])
  @@map("operational_costs")
}

// Health Score de Clientes
model CustomerHealth {
  id            String      @id @default(cuid())
  clienteId     String      @unique
  cliente       Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  healthScore   HealthScore @default(MEDIO)
  scoreNumerico Int         @default(50) // 0-100

  // Fatores de health score
  usoProduto    Int?        // Score de uso (0-100)
  nps           Int?        // Net Promoter Score (-100 a 100)
  ticketsAbertos Int         @default(0)
  diasSemUso    Int         @default(0)
  riscoPagamento Boolean    @default(false)

  // Notas e observações
  observacoes   String?
  ultimaRevisao DateTime    @default(now())

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([healthScore])
  @@index([scoreNumerico])
  @@index([riscoPagamento])
  @@map("customer_health")
}

// Movimentos de MRR (para NRR/GRR)
model MRRMovement {
  id          String           @id @default(cuid())
  tipo        TipoMRRMovement
  clienteId   String
  cliente     Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  valor       Decimal          @db.Decimal(10, 2)
  data        DateTime         @default(now())
  mes         Int              // 1-12
  ano         Int

  // Detalhes do movimento
  produtoId   String?
  produto     Produto?         @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  mrrAnterior Decimal?         @db.Decimal(10, 2)
  mrrNovo     Decimal?         @db.Decimal(10, 2)

  motivo      String?          // Motivo do churn/downgrade
  observacoes String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tipo])
  @@index([data])
  @@index([clienteId])
  @@index([mes, ano])
  @@index([mes, ano, tipo])
  @@map("mrr_movements")
}

// Projetos de Agência
model AgencyProject {
  id              String        @id @default(cuid())
  nome            String
  clienteId       String?
  cliente         Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  status          StatusProjeto @default(PLANEJAMENTO)

  // Datas
  dataInicio      DateTime      @default(now())
  dataPrevisao    DateTime?
  dataConclusao   DateTime?

  // Financeiro
  valorContratado Decimal       @db.Decimal(10, 2)
  valorFaturado   Decimal       @default(0) @db.Decimal(10, 2)

  // Horas
  horasEstimadas  Decimal       @db.Decimal(10, 2)
  horasRealizadas Decimal       @default(0) @db.Decimal(10, 2)
  horasFaturaveis Decimal       @default(0) @db.Decimal(10, 2)

  // Métricas
  custoReal       Decimal       @default(0) @db.Decimal(10, 2)
  margemBruta     Decimal?      @db.Decimal(10, 2) // Calculada

  descricao       String?
  observacoes     String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([clienteId])
  @@index([dataInicio])
  @@map("agency_projects")
}

// Tickets de Suporte
model SupportTicket {
  id            String           @id @default(cuid())
  clienteId     String
  cliente       Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  titulo        String
  descricao     String?
  prioridade    PrioridadeTicket @default(MEDIA)
  status        StatusTicket     @default(ABERTO)

  // SLA
  dataAbertura  DateTime         @default(now())
  dataResposta  DateTime?
  dataResolucao DateTime?
  dataFechamento DateTime?

  // Métricas
  tempoResposta Int?             // Minutos até primeira resposta
  tempoResolucao Int?            // Minutos até resolução
  primeiroContato Boolean        @default(true) // FCR - First Contact Resolution

  // Responsável
  responsavelId String?

  observacoes   String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([prioridade])
  @@index([clienteId])
  @@index([dataAbertura])
  @@map("support_tickets")
}

// Saldo de Caixa (para Runway)
model CashBalance {
  id              String   @id @default(cuid())
  data            DateTime @default(now())
  mes             Int      // 1-12
  ano             Int

  saldoInicial    Decimal  @db.Decimal(10, 2)
  entradas        Decimal  @default(0) @db.Decimal(10, 2)
  saidas          Decimal  @default(0) @db.Decimal(10, 2)
  saldoFinal      Decimal  @db.Decimal(10, 2)

  // Métricas
  burnRate        Decimal? @db.Decimal(10, 2) // Queima mensal
  runwayMeses     Int?     // Meses de runway calculado

  observacoes     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([mes, ano])
  @@index([mes, ano])
  @@index([data])
  @@map("cash_balances")
}
