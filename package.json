{
  "name": "sisfin",
  "version": "2.0.0",
  "description": "Sistema Financeiro Avançado com Prisma ORM - Multi-moeda, Notificações, Anexos e Controle de Acesso",
  "main": "index.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "jobs:start": "node src/jobs/index.js",
    "init:system": "node -e \"const p = require('./src/services/permissaoService'); const m = require('./src/services/moedaService'); (async () => { await p.inicializarSistema(); await m.inicializarMoedasPadrao(); })()\"",
    "examples": "node examples/api-examples.js"
  },
  "keywords": [
    "financial",
    "prisma",
    "orm",
    "multi-currency",
    "notifications",
    "access-control",
    "recurring-transactions"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.654.0",
    "@aws-sdk/s3-request-presigner": "^3.654.0",
    "nodemailer": "^6.9.15",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2"
  }
}
