# Database Connection
# PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://usuario:senha@localhost:5432/sisfin?schema=public"

# Server Port
PORT=3000

# Exemplo para desenvolvimento local:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sisfin_dev?schema=public"

# Exemplo para produção (Railway, Supabase, EasyPanel, etc):
# DATABASE_URL="postgresql://user:password@host.railway.app:5432/railway"
